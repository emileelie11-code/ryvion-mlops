# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Environments
.venv/
venv/
env/
ENV/
.env

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*-testresults.xml

# MLflow local tracking store (created by a local training run)
mlruns/
mlartifacts/

# MLflow local SQLite backend, which the model registry needs
# (MLFLOW_TRACKING_URI=sqlite:///mlflow.db)
mlflow.db

# The model exported for the serving image to bake in. It is a build input
# produced by a local training run, not something committed: the seed dataset
# and the training code are what this repository versions.
serving/model/

# Editors and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Local, per-developer Claude Code settings
.claude/settings.local.json
